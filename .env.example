# =========================
# LottoPilot runtime config
# =========================
# Copy to .env and edit before first start.
# docker compose automatically loads .env from repo root.

APP_NAME=LottoPilot
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8088
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_GIT_COMMIT=dev
APP_BUILD_TIME=

# Cookie / session
SESSION_COOKIE_NAME=lottopilot_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lottopilot
POSTGRES_USER=lottopilot
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://lottopilot:change-me-db-password@postgres:5432/lottopilot

# Host published port for the app container
HOST_PORT=8088

# Timezone used by app and postgres
TZ=Asia/Shanghai

# Scheduler (local time)
SYNC_CRON_SSQ=0 22 * * 2,4,7
SYNC_CRON_DLT=5 21 * * 1,3,6
SYNC_ENABLED=true

# AI defaults (keys are configured in-app after setup)
AI_DEFAULT_TIMEOUT_SECONDS=30
AI_DEFAULT_MAX_TOKENS=1024
AI_WEIGHT_CAP=0.10

# CORS / Origin check
# Comma-separated absolute origins. Leave empty to derive from APP_PUBLIC_URL.
CORS_ALLOWED_ORIGINS=

# Frontend build-time public path
VITE_API_BASE_URL=/api/v1


# ----------------------------
# Local no-Docker smoke (optional)
# ----------------------------
# For scripts/local_sqlite_e2e.py and scripts/local_fullstack_smoke.py the scripts
# set DATABASE_URL=sqlite+pysqlite:///... automatically. Production/compose still
# requires PostgreSQL via DATABASE_URL above.
# SYNC_ENABLED=false


# Production image (for deploy/baota/docker-compose.yml)
# LOTTOPILOT_IMAGE=ghcr.io/<owner>/lottopilot:v1.0.0
